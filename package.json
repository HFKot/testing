{
  "name": "voto-claro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync": "node scripts/sync.mjs",
    "test:e2e": "playwright test",
    "scrape": "node scripts/scrape.mjs",
    "import:evidence": "node scripts/import.mjs",
    "import:candidates": "node scripts/import-people.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.16.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
